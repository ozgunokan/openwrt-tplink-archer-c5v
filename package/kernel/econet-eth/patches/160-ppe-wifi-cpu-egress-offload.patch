+bool en75_ppe_offload_rx_cpu_xmit(struct en75_ppe *ppe, struct sk_buff *skb)
+{
+	struct net_device *odev;
+	struct ethhdr *eh;
+	int ifindex;
+
+	/* Not gated on wifi_offload: entries bound while it was on must keep
+	 * forwarding after it is switched off, until they age out. */
+	if (IS_ERR_OR_NULL(ppe) || !ppe->ndev)
+		return false;
+	if (skb->len < ETH_HLEN)
+		return false;
+
+	/* Only frames the PPE really rewrote for a CPU-egress flow: the source
+	 * MAC is the egress device's, the destination is not ours. Anything
+	 * else (e.g. an entry bound before wifi_offload was turned off) takes
+	 * the normal stack path untouched.
+	 */
+	eh = (struct ethhdr *)skb->data;
+	ifindex = en75_cpu_odev_lookup(eh->h_source);
+	if (!ifindex || !is_unicast_ether_addr(eh->h_dest) ||
+	    ether_addr_equal(eh->h_dest, ppe->ndev->dev_addr)) {
+		en75_diag[EN75_DIAG_RX_CPU_NOMATCH]++;
+		return false;
+	}
+
+	rcu_read_lock();
+	odev = dev_get_by_index_rcu(dev_net(ppe->ndev), ifindex);
+	if (!odev || !(odev->flags & IFF_UP)) {
+		rcu_read_unlock();
+		en75_diag[EN75_DIAG_RX_CPU_NOMATCH]++;
+		return false;
+	}
+
+	skb->dev = odev;
+	skb->protocol = eh->h_proto;
+	skb_reset_mac_header(skb);
+	skb_set_network_header(skb, ETH_HLEN);
+	skb->ip_summed = CHECKSUM_NONE;	/* the PPE already fixed the sums */
+	en75_diag[EN75_DIAG_RX_CPU_XMIT]++;
+	dev_queue_xmit(skb);
+	rcu_read_unlock();
+
+	return true;
+}
+
 void en75_ppe_offload_rx_commit(struct en75_ppe *ppe, struct sk_buff *skb,
 				u32 hw_slot)
 {
