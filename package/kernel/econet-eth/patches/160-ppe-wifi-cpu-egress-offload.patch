 #include "econet_ppe.h"
 
+/*
+ * Wi-Fi (non-GDM egress) offload, the "ExtIf" scheme of the vendor hw_nat:
+ * a flow that enters on the wired port but leaves on another netdev (br-lan
+ * towards Wi-Fi clients) is bound with the CPU as PSE egress port. The PPE
+ * still does the NAT and the L2 rewrite, and the CPU only hands the frame to
+ * the egress device. Off by default; enable with
+ *   echo 1 > /sys/module/econet_eth/parameters/wifi_offload
+ */
+static bool en75_wifi_offload;
+module_param_named(wifi_offload, en75_wifi_offload, bool, 0644);
+MODULE_PARM_DESC(wifi_offload, "Offload wired->non-GDM (Wi-Fi) flows to the PPE with CPU egress");
+
+#define EN75_CPU_ODEV_MAX 8
+
+/* Egress devices of CPU-port flows, matched on the rewritten source MAC.
+ * Append-only, written under en75_flow_offload_mutex, read locklessly. */
+static struct {
+	int ifindex;
+	u8 mac[ETH_ALEN];
+} en75_cpu_odevs[EN75_CPU_ODEV_MAX];
+static int en75_cpu_odev_num;
+
+static void en75_cpu_odev_register(const struct net_device *dev, const u8 *mac)
+{
+	int i, n = en75_cpu_odev_num;
+
+	for (i = 0; i < n; i++)
+		if (en75_cpu_odevs[i].ifindex == dev->ifindex &&
+		    ether_addr_equal(en75_cpu_odevs[i].mac, mac))
+			return;
+	if (n >= EN75_CPU_ODEV_MAX)
+		return;
+
+	en75_cpu_odevs[n].ifindex = dev->ifindex;
+	ether_addr_copy(en75_cpu_odevs[n].mac, mac);
+	smp_wmb();
+	WRITE_ONCE(en75_cpu_odev_num, n + 1);
+}
+
+static int en75_cpu_odev_lookup(const u8 *mac)
+{
+	int i, n = READ_ONCE(en75_cpu_odev_num);
+
+	smp_rmb();
+	for (i = 0; i < n; i++)
+		if (ether_addr_equal(en75_cpu_odevs[i].mac, mac))
+			return en75_cpu_odevs[i].ifindex;
+	return 0;
+}
